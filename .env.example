# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# Feature Flags
# Story 2.10: Enable end-to-end encryption (set to "true" to enable)
NEXT_PUBLIC_ENABLE_ENCRYPTION=false
# Epic 1.10: Enable Tasks & Reminders system (set to "true" to enable in development)
NEXT_PUBLIC_ENABLE_TEMPORAL=false

# Sentry Configuration (Error Tracking & Performance Monitoring)
# Get your DSN from https://sentry.io/settings/jotes/projects/jotes/keys/
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
# Auth token for uploading source maps to Sentry (get from https://sentry.io/settings/account/tokens/)
SENTRY_AUTH_TOKEN=your_sentry_auth_token
